# Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose this value through a VITE_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server-side image generation key. Never expose it through a VITE_ variable.
VOLCENGINE_API_KEY=xxx

# Optional: Upstash Redis REST credentials. The API works without Redis.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Comma-separated browser origins. Use * only for a public development API.
CORS_ORIGINS=http://localhost:3000
PORT=8787
